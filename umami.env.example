# Copy to umami.env (gitignored) and replace every "change-me" with a random value, e.g.:
#   openssl rand -hex 24   (passwords, APP_SECRET)
#   openssl rand -hex 32   (TWO_FACTOR_ENCRYPTION_KEY: exactly 64 hex characters)

# Umami's own Postgres (a separate container; not the game's Supabase database)
POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=change-me

# Umami itself; the password here must match POSTGRES_PASSWORD
DATABASE_URL=postgresql://umami:change-me@umami-db:5432/umami
APP_SECRET=change-me
TWO_FACTOR_ENCRYPTION_KEY=change-me
