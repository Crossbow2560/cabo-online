{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@cabo/server"
      ],
      "port": 3101
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@cabo/web"
      ],
      "port": 5173
    },
    {
      "name": "server-seeded",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CABO_SEED=12817",
        "npm",
        "run",
        "dev",
        "-w",
        "@cabo/server"
      ],
      "port": 3101
    }
  ]
}